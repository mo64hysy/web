# Discord application bot token. Keep this secret.
DISCORD_BOT_TOKEN=
# Optional: register slash commands to one test server for faster updates.
# Leave blank to register globally.
DISCORD_GUILD_ID=

# Public HTTPS origin, e.g. https://voice.example.com
PUBLIC_BASE_URL=https://your-domain.example
PORT=3000
HOST=0.0.0.0

# Use a persistent disk path in production.
DATABASE_PATH=./data/bridge.sqlite

# Optional: set to 1 only when running behind a trusted reverse proxy.
TRUST_PROXY=0